# Postgres connection. Local: docker compose up -d. Vercel: Neon integration sets it.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
# Random 32+ byte string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# First account with this email is promoted to admin by `npm run db:seed`.
ADMIN_EMAIL=
